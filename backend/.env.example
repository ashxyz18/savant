# Backend - production environment for Hostinger hPanel Node.js app
# Copy this file to `.env` on the server (next to package.json) and fill in real values.

# Port Passenger listens on. On hPanel this is injected; leave as-is for Passenger.
# For manual/SSH testing you can set PORT=5000.
PORT=3001

# Comma-separated list of allowed frontend origins for CORS.
# Add your Vercel preview URL and production domain, plus the backend subdomain if needed.
FRONTEND_URL=https://www.savantbd.com,https://savantbd.com

# JWT secret used to sign auth tokens. Use a long random string (>= 32 chars).
JWT_SECRET=replace-with-a-strong-random-secret

# ---- Email (nodemailer) ----
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=roseobd@mail.com
SMTP_PASSWORD=your_gmail_app_password

# ---- Not currently used by the app, but present in deps ----
# These are listed in package.json but the app reads from data/*.json and local uploads/.
# Leave blank unless you later switch to Atlas or Cloudinary.
MONGODB_URI=
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
