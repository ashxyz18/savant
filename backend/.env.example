# Backend - production environment (deployed on Render, frontend on Hostinger)
# Copy this file to `.env` on the server (next to package.json) and fill in real values.

# Render injects PORT automatically; only set for local `npm run dev` testing.
PORT=5000

# Comma-separated list of allowed frontend origins for CORS (your Hostinger site).
FRONTEND_URL=https://www.savantbd.com,https://savantbd.com

# JWT secret used to sign auth tokens. Use a long random string (>= 32 chars).
JWT_SECRET=replace-with-a-strong-random-secret

# ---- Email (nodemailer) ----
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=support@savantbd.com
SMTP_PASSWORD=your_gmail_app_password

# ---- Database (REQUIRED) ----
# MongoDB Atlas connection string. The app uses Mongoose against Atlas so data
# persists across Render restarts/deploys. Get it from your Atlas cluster:
#   mongodb+srv://<user>:<password>@<cluster>/<dbname>?retryWrites=true&w=majority
MONGODB_URI=mongodb+srv://USER:PASSWORD@cluster0.xxxxx.mongodb.net/savant

# ---- Not used unless you enable Cloudinary uploads ----
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
