# Backend (Render) environment variables.
# Set these in the Render dashboard (Service -> Environment) for production.

# JWT secret for signing auth tokens.
JWT_SECRET=change-me

# MongoDB connection string.
MONGODB_URI=mongodb+srv://user:pass@cluster0.xxxxx.mongodb.net/?appName=Cluster0

# Frontend CORS origin(s), comma-separated.
# FRONTEND_URL=http://localhost:3000,https://www.savant.com

# Public origin of the frontend (used for email/reset verification links).
# NEXT_PUBLIC_SITE_URL=https://www.savant.com

# Google OAuth client ID (same value as NEXT_PUBLIC_GOOGLE_CLIENT_ID on the
# frontend). Used to verify the id_token audience server-side. The client
# secret is NOT needed for the implicit id_token flow.
GOOGLE_CLIENT_ID=85378038902-gca30n5sigtpdov79g3j7aol69geci0e.apps.googleusercontent.com

# R2 / S3 image storage.
# S3_ENDPOINT=https://<accountid>.r2.cloudflarestorage.com
# S3_REGION=auto
# S3_BUCKET=savantbd
# S3_ACCESS_KEY_ID=...
# S3_SECRET_ACCESS_KEY=...
# S3_PUBLIC_URL=https://pub-<hash>.r2.dev

# SSLCOMMERZ payment gateway (API v4, hosted checkout).
# Sandbox creds below are the public SSLCOMMERZ test values; replace with your
# own store credentials from the SSLCOMMERZ merchant panel for production.
# Set SSLCOMMERZ_LIVE=1 and real creds before going live. The IPN URL
# (https://<site>/api/payment/ipn) must be registered in the merchant panel.
SSLCOMMERZ_STORE_ID=testbox
SSLCOMMERZ_STORE_PASSWORD=qwerty
SSLCOMMERZ_LIVE=0
