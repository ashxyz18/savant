# Frontend (Vercel) environment variables.
# Copy to `.env.local` for local dev, and set these in the Vercel dashboard
# (Project -> Settings -> Environment Variables) for production.

# Base URL of the live Render backend API (must end in /api).
# Example: https://savant-backend.onrender.com/api
NEXT_PUBLIC_API_URL=https://your-backend.onrender.com/api

# Public origin of THIS frontend (used for metadataBase / OG URLs).
# Example: https://savant.vercel.app  (or your custom domain https://www.savant.com)
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Used by next.config.js remotePatterns to allow /uploads images from the
# backend host (only matters if you switch images back to optimized).
BACKEND_PROTOCOL=https
BACKEND_HOSTNAME=your-backend.onrender.com
